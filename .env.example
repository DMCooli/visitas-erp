# ==============================================================================
# VISITAS ERP - Variables de Configuración de Entorno
# ==============================================================================
# Copia este archivo a .env antes de iniciar los contenedores:
#   cp .env.example .env
# Luego completa los valores requeridos.

# 1. Base de Datos PostgreSQL
DB_PASSWORD=tu_contrasena_postgres_segura

# 2. Firebase Authentication (Google OAuth)
# Obtenidos en la consola de Firebase > Configuración del Proyecto > General > Tus apps (Web)
FIREBASE_API_KEY=tu_firebase_api_key
FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu_proyecto_id
FIREBASE_APP_ID=tu_firebase_app_id

# 3. Sesión y Seguridad (JWT)
# Genera una cadena aleatoria segura de al menos 32 caracteres (ej: openssl rand -hex 32)
JWT_SECRET=genera_un_jwt_secret_largo_y_seguro

# 4. Usuario Master Inicial (Administrador Supremo del Sistema)
# El usuario con este correo de Gmail tendrá rol 'master' y acceso nativo a auditoría y logs.
INITIAL_MASTER_EMAIL=admin@tu-dominio.com

# 5. Parámetros de la Aplicación
COOKIE_SECURE=false
APP_TZ=America/Caracas
APP_PORT=3000
